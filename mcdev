#!/bin/sh
# Source checkout launcher; the compiled executable needs no Dart/Flutter SDK.
set -eu
MCDEV_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${DART:-}" ]; then
  MCDEV_DART=$DART
elif command -v dart >/dev/null 2>&1; then
  MCDEV_DART=$(command -v dart)
elif command -v flutter >/dev/null 2>&1; then
  MCDEV_FLUTTER=$(command -v flutter)
  while [ -L "$MCDEV_FLUTTER" ]; do
    MCDEV_LINK=$(readlink "$MCDEV_FLUTTER")
    case "$MCDEV_LINK" in
      /*) MCDEV_FLUTTER=$MCDEV_LINK ;;
      *) MCDEV_FLUTTER=$(dirname "$MCDEV_FLUTTER")/$MCDEV_LINK ;;
    esac
  done
  MCDEV_DART=$(dirname "$MCDEV_FLUTTER")/dart
elif [ -x "$MCDEV_ROOT/build/cli/mcdev" ]; then
  exec "$MCDEV_ROOT/build/cli/mcdev" "$@"
else
  echo '{"ok":false,"error":{"code":"sdk_missing","message":"Set DART to your Dart executable, install Flutter, or run build/cli/mcdev."}}'
  exit 1
fi
exec "$MCDEV_DART" --packages="$MCDEV_ROOT/.dart_tool/package_config.json" "$MCDEV_ROOT/bin/mcdev.dart" "$@"
